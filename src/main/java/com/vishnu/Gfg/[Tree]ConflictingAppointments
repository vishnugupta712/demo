public class ConflictingAppointments {

//TC O(n log n)
//SC O(n)
    static class Interval {
        int low;
        int high;

        Interval(int low, int high) {
            this.low = low;
            this.high = high;
        }
    }

    static class ITNode {
        Interval interval;
        int max; // Maximum end-time in this node's subtree
        ITNode left;
        ITNode right;

        ITNode(Interval interval) {
            this.interval = interval;
            this.max = interval.high;
        }
    }

    static boolean overlaps(Interval a, Interval b) {
        return a.low < b.high && b.low < a.high;
    }

    static ITNode insert(ITNode root, Interval current) {
        if (root == null) {
            return new ITNode(current);
        }

        if (current.low < root.interval.low) {
            root.left = insert(root.left, current);
        } else {
            root.right = insert(root.right, current);
        }

        root.max = Math.max(root.max, current.high);
        return root;
    }

    static Interval findConflict(ITNode root, Interval current) {
        if (root == null) {
            return null;
        }

        // Current interval conflicts with this node's interval.
        if (overlaps(root.interval, current)) {
            return root.interval;
        }

        // Left subtree can have a conflict only if it extends past current.low.
        if (root.left != null && root.left.max > current.low) {
            return findConflict(root.left, current);
        }

        return findConflict(root.right, current);
    }

    static void printConflicting(int[][] appointments) {
        if (appointments.length == 0) {
            return;
        }

        ITNode root = new ITNode(
            new Interval(appointments[0][0], appointments[0][1])
        );

        for (int i = 1; i < appointments.length; i++) {
            Interval current = new Interval(
                appointments[i][0],
                appointments[i][1]
            );

            Interval conflict = findConflict(root, current);

            if (conflict != null) {
                System.out.println(
                    "[" + current.low + ", " + current.high + "] conflicts with "
                    + "[" + conflict.low + ", " + conflict.high + "]"
                );
            }

            root = insert(root, current);
        }
    }

    public static void main(String[] args) {
        int[][] appointments = {
            {1, 5},
            {3, 7},
            {2, 6},
            {10, 15},
            {5, 6},
            {4, 100}
        };

        printConflicting(appointments);
    }
}
